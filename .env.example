# Hosted runtime: configure through Sites environment variables.
ADMIN_EMAILS=
# Comma-separated verified administrator email allowlist; never accept this from the browser.

# Vercel migration (server-only; never prefix secrets with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_IMAGE_BUCKET=research-images

# Optional canonical origin; omit for Vercel Preview automatic host detection.
APP_ORIGIN=
